{
  "name": "@russellio/vue-background-stars",
  "version": "1.4.0",
  "description": "A beautiful animated starry night sky background component for Vue 3 with optional toggle control",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/vue-background-stars.es.d.ts",
      "import": "./dist/vue-background-stars.es.js",
      "require": "./dist/vue-background-stars.umd.js"
    },
    "./style.css": "./dist/vue-background-stars.css"
  },
  "main": "./dist/vue-background-stars.umd.js",
  "module": "./dist/vue-background-stars.es.js",
  "types": "./dist/vue-background-stars.es.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "format": "prettier --write \"**/*.{js,ts,vue,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,ts,vue,json,md}\"",
    "prepare": "husky",
    "prepublishOnly": "npm run type-check && npm run test:run && npm run build"
  },
  "keywords": [
    "vue",
    "vue3",
    "background",
    "stars",
    "animation",
    "night-sky",
    "component",
    "ui"
  ],
  "author": "Jon Russell",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/russellio/vue-background-stars.git"
  },
  "bugs": {
    "url": "https://github.com/russellio/vue-background-stars/issues"
  },
  "homepage": "https://russellio.github.io/vue-background-stars/",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.12.0"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "lint-staged": {
    "*.{ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,json,md,css}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.4",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/language-core": "^3.3.13",
    "@vue/test-utils": "^2.5.1",
    "axe-core": "^4.14.0",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vitest": "^5.0.5",
    "vitest-axe": "^0.1.0",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  },
  "packageManager": "pnpm@12.14.0"
}
